# Telegram bot token from @BotFather
BOT_TOKEN=

# LLM providers in priority order; empty key = skipped. Old file: .env.bak

# Cerebras: fastest (~1 s/call) and most accurate in tests; free tier = 5 req/min per model
LLM1_TYPE=openai
LLM1_BASE_URL=https://api.cerebras.ai/v1
LLM1_API_KEY=
LLM1_MODEL=gpt-oss-120b
LLM1_MAX_TOKENS=2000
LLM1_EXTRA='{"reasoning_effort":"low"}'

# Gemini key 2 (own quota)
LLM2_TYPE=openai
LLM2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM2_API_KEY=
LLM2_MODEL=gemini-3.5-flash
LLM2_MAX_TOKENS=2000
LLM2_EXTRA='{"reasoning_effort":"low"}'

# Gemini key 1 (own quota)
LLM3_TYPE=openai
LLM3_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM3_API_KEY=
LLM3_MODEL=gemini-3.5-flash
LLM3_MAX_TOKENS=2000
LLM3_EXTRA='{"reasoning_effort":"low"}'

# Cerebras second model: separate 5 req/min quota
LLM4_TYPE=openai
LLM4_BASE_URL=https://api.cerebras.ai/v1
LLM4_API_KEY=
LLM4_MODEL=qwen-3.8-27b
LLM4_MAX_TOKENS=2000

# Gemini Flash-Lite key 2: separate per-model quota
LLM5_TYPE=openai
LLM5_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM5_API_KEY=
LLM5_MODEL=gemini-3.5-flash-lite
LLM5_MAX_TOKENS=2000
LLM5_EXTRA='{"reasoning_effort":"low"}'

# Gemini Flash-Lite key 1
LLM6_TYPE=openai
LLM6_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM6_API_KEY=
LLM6_MODEL=gemini-3.5-flash-lite
LLM6_MAX_TOKENS=2000
LLM6_EXTRA='{"reasoning_effort":"low"}'

# Paid DeepSeek (empty = skipped)
LLM7_TYPE=openai
LLM7_BASE_URL=https://api.deepseek.com
LLM7_API_KEY=
LLM7_MODEL=deepseek-chat
